# 農業情報基盤へのデータ送信設定
# この環境変数で実際の送信を制御します

# 実送信を有効にする (true: 実送信, false: シミュレーションのみ)
# デフォルト: false
VITE_AGRI_SEND_ENABLE=false

# FIWARE/ORION 設定
# ORIONのベースURL
VITE_ORION_BASE_URL='http://localhost'
# ORIONのAPIパス
VITE_ORION_API_PATH='/api/orion'
# NGSI-LDエンティティID
VITE_ORION_ENTITY_ID=urn:ngsi-ld:AgrifarmRobotHouseSnapshot:site-01
